{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "prod-auto",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3200,
      "autoPort": true
    }
  ]
}
