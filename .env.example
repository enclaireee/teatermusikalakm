# Copy to .env.local and fill from Supabase → Project Settings → API.
# Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Login for /admin (backend.md step 7). Password: at least 12 characters.
ADMIN_USER=
ADMIN_PASSWORD=
# Public site origin used for canonical URLs, sitemap and OG tags (e.g. https://example.com)
# NEXT_PUBLIC_SITE_URL=
